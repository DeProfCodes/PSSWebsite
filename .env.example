# =============================================================================
# Proficient Software Solutions website — environment variables
#
# NAMES ONLY. Never put real values in this file or in any committed file.
#   Local development: copy to .env.local (git-ignored) and fill in.
#   Vercel: Project → Settings → Environment Variables (set per environment).
#
# Variables prefixed NEXT_PUBLIC_ are inlined into browser JavaScript at build
# time — they must never hold secrets. Everything else is server-only.
# See README.md → "Environment variables" for the full explanation.
#
# REQUIRED in Vercel Production (the contact form answers 503 without them):
#   EMAIL_PROVIDER, CONTACT_EMAIL_TO, CONTACT_EMAIL_CC, CONTACT_EMAIL_FROM,
#   plus SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD   (EMAIL_PROVIDER=smtp)
#     or RESEND_API_KEY                                        (EMAIL_PROVIDER=resend)
# RECOMMENDED: NEXT_PUBLIC_GA_ID (no analytics without it).
# OPTIONAL: NEXT_PUBLIC_SITE_URL (defaults to the www domain).
# LEAVE EMPTY: TURNSTILE_SECRET_KEY (the form does not render the widget yet).
# =============================================================================


# --- Site --------------------------------------------------------------------

# Canonical origin used for canonical links, sitemap.xml, robots.txt, Open Graph
# and JSON-LD. Origin only, no trailing slash.
# Defaults to https://www.proficientsoftwaresolutions.co.za when empty.
NEXT_PUBLIC_SITE_URL=


# --- Analytics ---------------------------------------------------------------

# GA4 measurement ID. When empty, no analytics script is rendered.
# Set it in the Vercel *Production* environment only, so local and Preview
# traffic does not pollute production reports.
# The legacy site's property (CURRENT_WEBSITE_AUDIT.md §1.16) is G-VLLB11SKWE —
# reuse it to keep analytics continuity. (A measurement ID is public, not a secret.)
NEXT_PUBLIC_GA_ID=


# --- Contact form: POST /api/contact (server-only) -----------------------------

# Email transport: smtp | resend | log
#   smtp   — any SMTP mailbox (uses the SMTP_* variables below)
#   resend — Resend HTTP API (uses RESEND_API_KEY)
#   log    — development only: logs a redacted summary instead of sending.
#            Refused when VERCEL_ENV=production.
# Empty = sending disabled; the endpoint answers 503 "not_configured".
EMAIL_PROVIDER=

# Where enquiries are delivered (the primary PSS inbox). Comma-separated list of addresses.
CONTACT_EMAIL_TO=

# Addresses copied (CC) on every enquiry. Comma-separated; optional.
# Required value for Production (per PSS, 2026-09-23): nproficientm@gmail.com
CONTACT_EMAIL_CC=

# Sender address. Must be a mailbox/domain the chosen provider is allowed to
# send from (SPF/DKIM aligned), otherwise mail will be rejected or spam-foldered.
# The visitor's address is set as Reply-To, never as From.
CONTACT_EMAIL_FROM=

# SMTP (EMAIL_PROVIDER=smtp). Use EXACTLY the outgoing-mail (SMTP) host and port
# published by the mailbox provider — a value is not valid just because it is set:
#   SMTP_PORT=465 → implicit TLS from the first byte
#   SMTP_PORT=587 → plain connect, then a mandatory STARTTLS upgrade
#   A port that only speaks plaintext SMTP is refused before credentials are sent.
# SMTP_HOST must be a name on the server's TLS certificate (certificates are
# always validated — a domain alias the certificate doesn't cover will fail).
# Check the settings without sending anything: npm run email:verify
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Resend (EMAIL_PROVIDER=resend). The CONTACT_EMAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=

# Cloudflare Turnstile secret. LEAVE EMPTY for launch: when set, /api/contact
# REQUIRES a valid `turnstileToken` in every request, and the contact form does
# not render the Turnstile widget, so every enquiry would be rejected.
# Spam protection without it: honeypot field + per-IP rate limiting.
TURNSTILE_SECRET_KEY=
